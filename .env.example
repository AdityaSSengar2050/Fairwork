# FairWork Environment Configuration
PORT=3000

# Google Cloud Service Integration
# Service: Google Cloud Natural Language API
# Role required (Least Privilege): roles/cloudnaturallanguage.serviceAgent or roles/automl.viewer
# Leave empty to run with deterministic offline rule-based NLP analyzer fallback.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=fairwork-hackathon-prod
GOOGLE_CLOUD_API_KEY=
